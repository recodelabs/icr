tools/campaign-builder/*.egg-info/

# data/ analytics hub: derived parquet + raw NDJSON are disposable, regenerated by tools/warehouse/refresh.sh.
# The Portolan catalog metadata beside the parquet (collection.json, items, README/AGENTS.md,
# versions.json) is tracked — it is the published catalog, git-backed.
data/raw/
data/parquet/**/*.parquet
data/parquet/locations/.portolan/
data/parquet/_report.json
data/.portolan/.versions.lock
data/tiles/

