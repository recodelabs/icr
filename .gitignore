docs/contract/Complete_with_Docusign_*.pdf

# git worktrees created for isolated work
.claude/worktrees/

.venv/
__pycache__/
*.pyc
tools/espen-mda-datagen/**/sample-data/

# tools/hapi scratch (kiln snapshots / parquet output)
