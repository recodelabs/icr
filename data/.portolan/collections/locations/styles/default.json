{
  "version": 8,
  "name": "Administrative boundaries",
  "metadata": {"portolan:description": "Country, state and LGA boundaries with health facilities on top; settlements appear from zoom 8. Sources are listed in the order of the collection's PMTiles assets (admin, facilities, settlements)."},
  "sources": {
    "data": {"type": "vector", "url": "pmtiles://../../../tiles/admin.pmtiles", "minzoom": 4, "maxzoom": 11, "attribution": "UNICEF ICR · Recode Labs · GRID3"},
    "facilities": {"type": "vector", "url": "pmtiles://../../../tiles/facilities.pmtiles", "minzoom": 4, "maxzoom": 12},
    "settlements": {"type": "vector", "url": "pmtiles://../../../tiles/settlements.pmtiles", "minzoom": 8, "maxzoom": 13}
  },
  "layers": [
    {"id": "lgas-fill", "type": "fill", "source": "data", "source-layer": "lgas",
     "paint": {"fill-color": "#dfe8f1", "fill-opacity": 0.7}},
    {"id": "lgas-line", "type": "line", "source": "data", "source-layer": "lgas",
     "paint": {"line-color": "#9db4cc", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.3, 11, 1]}},
    {"id": "states-line", "type": "line", "source": "data", "source-layer": "states",
     "paint": {"line-color": "#4a6d8c", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.8, 11, 2]}},
    {"id": "country-line", "type": "line", "source": "data", "source-layer": "country",
     "paint": {"line-color": "#1f3a53", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 1.2, 11, 3]}},
    {"id": "settlements", "type": "circle", "source": "settlements", "source-layer": "settlements", "minzoom": 8,
     "paint": {"circle-radius": ["interpolate", ["linear"], ["zoom"], 8, 1, 13, 3], "circle-color": "#8d6e63", "circle-opacity": 0.6}},
    {"id": "facilities", "type": "circle", "source": "facilities", "source-layer": "facilities",
     "paint": {
       "circle-radius": ["interpolate", ["linear"], ["zoom"], 4, 1, 8, 2, 12, 5],
       "circle-color": "#1565c0", "circle-opacity": 0.8,
       "circle-stroke-color": "#ffffff", "circle-stroke-width": ["interpolate", ["linear"], ["zoom"], 4, 0, 10, 0.6]
     }}
  ]
}
