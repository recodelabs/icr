{
  "version": 8,
  "name": "Settlements",
  "metadata": {"portolan:description": "Every settlement in the registry (zoom 8 and above, no point dropped) over faint boundaries. Sources are listed in the order of the collection's PMTiles assets (admin, facilities, settlements)."},
  "sources": {
    "data": {"type": "vector", "url": "pmtiles://../../../tiles/admin.pmtiles", "minzoom": 4, "maxzoom": 11, "attribution": "UNICEF ICR · Recode Labs · GRID3"},
    "facilities": {"type": "vector", "url": "pmtiles://../../../tiles/facilities.pmtiles", "minzoom": 4, "maxzoom": 12},
    "settlements": {"type": "vector", "url": "pmtiles://../../../tiles/settlements.pmtiles", "minzoom": 8, "maxzoom": 13}
  },
  "layers": [
    {"id": "lgas-line", "type": "line", "source": "data", "source-layer": "lgas",
     "paint": {"line-color": "#c5d2de", "line-width": 0.5}},
    {"id": "states-line", "type": "line", "source": "data", "source-layer": "states",
     "paint": {"line-color": "#7f97ad", "line-width": 1}},
    {"id": "settlements", "type": "circle", "source": "settlements", "source-layer": "settlements",
     "paint": {
       "circle-radius": ["interpolate", ["linear"], ["zoom"], 8, 1.2, 13, 4],
       "circle-color": "#6d4c41",
       "circle-opacity": 0.8
     }}
  ]
