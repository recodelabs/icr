{
  "version": 8,
  "name": "Administrative boundaries",
  "metadata": {
    "portolan:description": "Uganda's districts and cities, with region and country outlines."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../../../tiles/admin.pmtiles",
      "minzoom": 4,
      "maxzoom": 11,
      "attribution": "\u00a9 OpenStreetMap contributors (ODbL), via Overture Maps \u00b7 OCHA COD-AB \u00b7 UNICEF ICR"
    }
  },
  "layers": [
    {
      "id": "districts-fill",
      "type": "fill",
      "source": "data",
      "source-layer": "admin2",
      "paint": {
        "fill-color": "#dfe8f1",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "districts-line",
      "type": "line",
      "source": "data",
      "source-layer": "admin2",
      "paint": {
        "line-color": "#9db4cc",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.4,
          11,
          1.2
        ]
      }
    },
    {
      "id": "regions-line",
      "type": "line",
      "source": "data",
      "source-layer": "admin1",
      "paint": {
        "line-color": "#4a6d8c",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          1,
          11,
          2.5
        ]
      }
    },
    {
      "id": "country-line",
      "type": "line",
      "source": "data",
      "source-layer": "admin0",
      "paint": {
        "line-color": "#1f3a53",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          1.4,
          11,
          3
        ]
      }
    },
    {
      "id": "district-names",
      "type": "symbol",
      "source": "data",
      "source-layer": "admin2",
      "minzoom": 7,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#1f3a53",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ]
}
