build/
overture/
cod/
targets-names.csv
# sdi/ is written by sdi.sh, except the catalog's human-written metadata and its root files
# (portolan needs catalog.json to recognise the catalog).
sdi/*
!sdi/.portolan/
!sdi/catalog.json
!sdi/versions.json
!sdi/README.md
!sdi/AGENTS.md
!sdi/parquet/
sdi/parquet/*
!sdi/parquet/.portolan/
