# data/data.env on the VM (not in git). See README.md in this folder.
# The gateway API key the refreshes use: `k create data` (gateway/api-key.sh) prints it.
FHIR_PIPES_CLIENT_ID=key-data
FHIR_PIPES_CLIENT_SECRET=change-me
# Opens every path, for the operator: openssl rand -hex 32
FHIR_PIPES_SERVE_TOKEN=change-me
# Memory for serve, its refreshes and queries.
DATA_MEMORY=3g
