# TLS via Let's Encrypt for $FHIR_HOST (the Cloudflare record must be DNS only, grey cloud).
{$FHIR_HOST} {
	encode gzip
	reverse_proxy hapi:3447
}

{$AUTH_HOST} {
	encode gzip
	reverse_proxy keycloak:8080
}

{$GATEWAY_HOST} {
	encode gzip
	# By container name: the country servers' gateways join this network and are also
	# called `gateway` there, so `gateway:8080` reaches any of them.
	reverse_proxy icr-hapi-gateway-1:8080
}

# One file per country server (country/docker-compose.yml), e.g. sites/uga.caddy.
import sites/*.caddy
